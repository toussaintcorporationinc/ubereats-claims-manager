ENVIRONMENT=production
APP_ENV=production
APP_NAME=TENNET
APP_VERSION=1.1.1-tennet
DEBUG=false
DOCS_ENABLED=false
SECRET_KEY=change-me-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
BACKEND_CORS_ORIGINS=https://app.thetennet.com
FRONTEND_URL=https://app.thetennet.com
API_BASE_URL=https://api.thetennet.com
NEXT_PUBLIC_API_BASE_URL=https://api.thetennet.com
BUILD_SHA=replace-with-git-sha

POSTGRES_DB=claims_manager
POSTGRES_USER=claims
POSTGRES_PASSWORD=change-me-database-password
DATABASE_URL=postgresql+psycopg://claims:change-me-database-password@postgres:5432/claims_manager

EVIDENCE_STORAGE_BACKEND=local
EVIDENCE_STORAGE_DIR=/app/data/evidence
IMPORT_STORAGE_DIR=/app/data/imports
IMPORT_MAX_FILE_SIZE_MB=10
SMART_IMPORT_PREVIEW_EXPIRY_HOURS=24
MAX_EVIDENCE_FILE_SIZE_MB=15

EMAIL_PROVIDER_ENABLED=false
RESEND_ENABLED=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=TENNET <notifications@mail.thetennet.com>
RESEND_REPLY_TO=
RESEND_DOMAIN=mail.thetennet.com
GMAIL_INBOUND_SYNC_ENABLED=false
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT_URI=https://api.thetennet.com/v1/email/gmail/oauth/callback
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.compose https://www.googleapis.com/auth/gmail.send https://www.googleapis.com/auth/gmail.modify https://www.googleapis.com/auth/gmail.readonly
DEFAULT_UBER_EATS_SUPPORT_EMAIL=restaurantsfrance@uber.com
EMAIL_MAX_ATTACHMENT_TOTAL_MB=20
GMAIL_INBOUND_SYNC_LOOKBACK_DAYS=30
GMAIL_INBOUND_MAX_MESSAGES_PER_SYNC=1000
GMAIL_STARRED_MAX_MESSAGES_PER_SYNC=50000
GMAIL_STARRED_FULL_HISTORY_ENABLED=true
GMAIL_STARRED_PAGE_SIZE=500
GMAIL_STARRED_MAX_PAGES_PER_SYNC=0
GMAIL_INBOUND_AUTO_SYNC_ENABLED=false
GMAIL_INBOUND_AUTO_SYNC_CONTINUOUS_ENABLED=true
GMAIL_INBOUND_AUTO_SYNC_INTERVAL_SECONDS=30
GMAIL_INBOUND_AUTO_SYNC_IDLE_SLEEP_SECONDS=1
GMAIL_INBOUND_AUTO_SYNC_INITIAL_DELAY_SECONDS=5
GMAIL_INBOUND_AUTO_SYNC_EXISTING_REPROCESS_LIMIT=1000
GMAIL_INBOUND_AUTO_SYNC_RUN_AUTOPILOT=true
GMAIL_INBOUND_AUTO_SYNC_RUN_WORKSPACE_MACHINE=true
GMAIL_DAILY_PROCESSING_TARGET=2000
GMAIL_QUOTA_RETRY_SAFETY_SECONDS=30
GMAIL_WATCHED_THREADS_ENABLED=true
GMAIL_WATCHED_THREADS_POLL_SECONDS=30
GMAIL_WATCHED_THREADS_FULL_RESCAN_MINUTES=15
GMAIL_WATCHED_THREADS_MAX_PER_CYCLE=5000
GMAIL_WATCHED_THREADS_BATCH_PER_CYCLE=100
GMAIL_WATCHED_THREADS_READ_BATCH_PER_CYCLE=100
GMAIL_WATCHED_THREADS_PROCESS_NEW_MESSAGES=true
GMAIL_SUPPORT_SENDER_FILTER=uber.com

FOLLOWUP_1_DELAY_DAYS=2
FOLLOWUP_2_DELAY_DAYS=5
ESCALATION_DELAY_DAYS=10
MANUAL_REVIEW_AFTER_DAYS=15
MAX_FOLLOWUPS_PER_ORDER=3
FOLLOWUP_AUTOMATIC_SEND_ENABLED=false

EXPORT_MAX_ROWS=10000
REPORT_DEFAULT_LOOKBACK_DAYS=90
UBER_RECONCILIATION_DEFAULT_LOOKBACK_DAYS=180
UBER_RECONCILIATION_AMOUNT_TOLERANCE=0.01
UBER_RECONCILIATION_MIN_MISSING_AMOUNT=0.01
UBER_RECONCILIATION_MAX_RESULTS=5000
EVIDENCE_TASK_HIGH_AMOUNT=50
EVIDENCE_TASK_URGENT_AMOUNT=100
EVIDENCE_UPLOAD_LINK_EXPIRY_HOURS=48
EVIDENCE_UPLOAD_LINK_MAX_USES=3
AI_EVIDENCE_ANALYSIS_ENABLED=false
AI_EVIDENCE_AUTO_ATTACH_ENABLED=false
AI_EVIDENCE_HIGH_CONFIDENCE_THRESHOLD=0.90
AI_EVIDENCE_MEDIUM_CONFIDENCE_THRESHOLD=0.65
AI_PROOF_IDENTITY_ENABLED=true
AI_GMAIL_ANALYSIS_ENABLED=true
AI_GMAIL_MIN_CONFIDENCE=0.70
BULK_EVIDENCE_MAX_FILES_PER_BATCH=500
BULK_EVIDENCE_MAX_ZIP_SIZE_MB=500
BULK_EVIDENCE_MAX_FILE_SIZE_MB=20
BULK_EVIDENCE_ALLOWED_EXTENSIONS=.pdf,.jpg,.jpeg,.png,.webp,.heic,.heif,.csv,.xlsx
OPENAI_API_KEY=
OPENAI_EVIDENCE_MODEL=
OPENAI_GMAIL_MODEL=
OPENAI_REQUEST_TIMEOUT_SECONDS=30
OCR_LOCAL_ENABLED=true
APPEALS_ENABLED=true
APPEAL_AUTO_SEND_ENABLED=false
APPEAL_MIN_DAYS_BETWEEN_ATTEMPTS=2
APPEAL_MAX_ATTEMPTS_BEFORE_ESCALATION=3
APPEAL_MAX_ATTEMPTS_BEFORE_MANUAL_REVIEW=6
APPEAL_REQUIRE_NEW_ARGUMENT_AFTER_REFUSAL=true
APPEAL_ALLOW_SAME_TEMPLATE_RESEND=false
AUTOPILOT_ENABLED=false
AUTOPILOT_INITIAL_CLAIMS_ENABLED=false
AUTOPILOT_FOLLOWUPS_ENABLED=false
AUTOPILOT_APPEALS_ENABLED=false
AUTOPILOT_DAILY_SEND_LIMIT=1000
AUTOPILOT_PER_GMAIL_ACCOUNT_DAILY_LIMIT=500
AUTOPILOT_PER_RESTAURANT_DAILY_LIMIT=250
AUTOPILOT_MIN_AMOUNT=5
AUTOPILOT_MAX_AMOUNT_WITHOUT_OWNER_REVIEW=150
AUTOPILOT_REQUIRE_COMPLETE_EVIDENCE=true
AUTOPILOT_REQUIRE_COMPLETE_RESTAURANT_SIGNATURE=true
AUTOPILOT_REQUIRE_GMAIL_CONNECTED=true
AUTOPILOT_COOLDOWN_HOURS=48
AUTOPILOT_REFUSAL_RETRY_ENABLED=true
AUTOPILOT_MAX_APPEAL_ATTEMPTS=6
AUTOPILOT_NEVER_CLOSE_ON_REFUSAL=true

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120
LOGIN_RATE_LIMIT_PER_MINUTE=10

COMPOSE_PROJECT_NAME=ubereats_claims_manager
