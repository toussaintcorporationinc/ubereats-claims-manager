(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
	}
}

app.thetennet.com {
	encode zstd gzip
	import security_headers

	reverse_proxy ubereats_claims_manager-frontend-1:3000
}

thetennet.com, www.thetennet.com {
	encode zstd gzip
	import security_headers

	redir https://app.thetennet.com{uri} permanent
}

api.thetennet.com {
	encode zstd gzip
	import security_headers

	request_body {
		max_size 25MB
	}

	reverse_proxy ubereats_claims_manager-backend-1:8000
}

staging-app.thetennet.com {
	encode zstd gzip
	import security_headers

	reverse_proxy tennet-staging-frontend:3000
}

staging-api.thetennet.com {
	encode zstd gzip
	import security_headers

	request_body {
		max_size 25MB
	}

	reverse_proxy tennet-staging-backend:8000
}
