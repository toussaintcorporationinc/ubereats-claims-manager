(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
	}
}

app.thetennet.com {
	encode zstd gzip
	import security_headers

	reverse_proxy frontend:3000
}

api.thetennet.com {
	encode zstd gzip
	import security_headers

	request_body {
		max_size 25MB
	}

	reverse_proxy backend:8000
}

app.leboxerfrancais.com {
	encode zstd gzip
	import security_headers

	reverse_proxy frontend:3000
}

api.leboxerfrancais.com {
	encode zstd gzip
	import security_headers

	request_body {
		max_size 25MB
	}

	reverse_proxy backend:8000
}

staging-app.thetennet.com {
	encode zstd gzip
	import security_headers

	reverse_proxy tennet-staging-frontend:3000
}

staging-api.thetennet.com {
	encode zstd gzip
	import security_headers

	request_body {
		max_size 25MB
	}

	reverse_proxy tennet-staging-backend:8000
}

