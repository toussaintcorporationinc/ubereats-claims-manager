{
  "expo": {
    "name": "TENNET",
    "slug": "tennet-mobile",
    "version": "1.0.2",
    "description": "Application native TENNET pour piloter les preuves, tickets, scans et actions de recuperation sur le terrain.",
    "scheme": "tennet",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.thetennet.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "TENNET utilise la camera pour photographier les preuves et scanner les QR codes de tickets.",
        "NSPhotoLibraryUsageDescription": "TENNET permet d'importer des preuves deja presentes sur l'appareil."
      }
    },
    "android": {
      "package": "com.thetennet.mobile",
      "permissions": [
        "CAMERA",
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_CONNECT",
        "BLUETOOTH_SCAN",
        "ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 5
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-sharing",
      "./plugins/withTennetNativePrinter"
    ],
    "extra": {
      "apiBaseUrl": "https://api.thetennet.com",
      "webAppUrl": "https://app.thetennet.com",
      "eas": {
        "projectId": "aa2dcd28-d76b-4a17-a49b-7ffdffa1bd99"
      }
    },
    "owner": "toussaintcorp"
  }
}
